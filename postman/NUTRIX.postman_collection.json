{
  "info": {
    "name": "NUTRIX API",
    "description": "Collection de test pour l'API NUTRIX : authentification, CRUD des 18 tables, endpoints calcules du moteur. Lance 'Login admin' (ou occupant/ferme) en premier : le token est stocke automatiquement dans la variable de collection {{token}} et reutilise par toutes les autres requetes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "1. Authentification",
      "item": [
        {
          "name": "Login admin",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const data = pm.response.json();",
            "pm.collectionVariables.set('token', data.token);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/login",
            "body": { "mode": "raw", "raw": "{\"username\":\"admin\",\"password\":\"password123\"}", "options": { "raw": { "language": "json" } } }
          }
        },
        {
          "name": "Login occupant",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const data = pm.response.json();",
            "pm.collectionVariables.set('token', data.token);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/login",
            "body": { "mode": "raw", "raw": "{\"username\":\"occupant\",\"password\":\"password123\"}", "options": { "raw": { "language": "json" } } }
          }
        },
        {
          "name": "Login ferme",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const data = pm.response.json();",
            "pm.collectionVariables.set('token', data.token);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/login",
            "body": { "mode": "raw", "raw": "{\"username\":\"ferme\",\"password\":\"password123\"}", "options": { "raw": { "language": "json" } } }
          }
        },
        {
          "name": "Register (auto-inscription)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/register",
            "body": { "mode": "raw", "raw": "{\"username\":\"nouveau\",\"password\":\"password123\",\"role\":\"ROLE_OCCUPANT\"}", "options": { "raw": { "language": "json" } } }
          }
        },
        {
          "name": "Me (profil courant)",
          "request": { "method": "GET", "url": "{{base_url}}/api/me" }
        }
      ]
    },
    {
      "name": "2. Referentiels (lecture)",
      "item": [
        { "name": "GET UniteStock", "request": { "method": "GET", "url": "{{base_url}}/api/unite_stocks" } },
        { "name": "GET CategorieIngredient", "request": { "method": "GET", "url": "{{base_url}}/api/categorie_ingredients" } },
        { "name": "GET CategorieRecette", "request": { "method": "GET", "url": "{{base_url}}/api/categorie_recettes" } },
        { "name": "GET TypeRepas", "request": { "method": "GET", "url": "{{base_url}}/api/type_repas" } },
        { "name": "GET ActivityLabel", "request": { "method": "GET", "url": "{{base_url}}/api/activity_labels" } },
        { "name": "GET Allergene", "request": { "method": "GET", "url": "{{base_url}}/api/allergenes" } },
        {
          "name": "POST CategorieIngredient (admin uniquement)",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/ld+json" }],
            "url": "{{base_url}}/api/categorie_ingredients",
            "body": { "mode": "raw", "raw": "{\"libelle\":\"Epice\"}", "options": { "raw": { "language": "json" } } }
          }
        }
      ]
    },
    {
      "name": "3. Equipage",
      "item": [
        { "name": "GET Equipage (liste)", "request": { "method": "GET", "url": "{{base_url}}/api/equipages" } },
        { "name": "GET Equipage 1", "request": { "method": "GET", "url": "{{base_url}}/api/equipages/1" } },
        {
          "name": "POST Equipage (admin uniquement)",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/ld+json" }],
            "url": "{{base_url}}/api/equipages",
            "body": { "mode": "raw", "raw": "{\"sexe\":true,\"age\":30,\"poidsKilo\":75.0,\"tailleCm\":178,\"bmi\":23.5,\"pal\":1.6,\"activityLabel\":\"/api/activity_labels/2\"}", "options": { "raw": { "language": "json" } } }
          }
        },
        { "name": "GET allergies de l'equipage 3", "request": { "method": "GET", "url": "{{base_url}}/api/equipages/3/allergies" } }
      ]
    },
    {
      "name": "4. Aliments & Recettes",
      "item": [
        { "name": "GET Aliment (liste)", "request": { "method": "GET", "url": "{{base_url}}/api/aliments" } },
        { "name": "GET Aliment TOMATE", "request": { "method": "GET", "url": "{{base_url}}/api/aliments/TOMATE" } },
        {
          "name": "POST Aliment (admin ou ferme)",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/ld+json" }],
            "url": "{{base_url}}/api/aliments",
            "body": { "mode": "raw", "raw": "{\"id\":\"CAROTTE\",\"libelle\":\"Carotte\",\"kcal100g\":41,\"proteines100g\":0.9,\"glucides100g\":9.6,\"lipides100g\":0.2,\"fibres100g\":2.8,\"cycleJoursMin\":70,\"cycleJoursMax\":90,\"rendementGM2J\":3.0,\"uniteStock\":\"/api/unite_stocks/2\",\"categorieIngredient\":\"/api/categorie_ingredients/1\"}", "options": { "raw": { "language": "json" } } }
          }
        },
        { "name": "GET Recette (liste)", "request": { "method": "GET", "url": "{{base_url}}/api/recettes" } },
        { "name": "GET Recette 1", "request": { "method": "GET", "url": "{{base_url}}/api/recettes/1" } },
        {
          "name": "POST Recette (admin uniquement)",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/ld+json" }],
            "url": "{{base_url}}/api/recettes",
            "body": { "mode": "raw", "raw": "{\"libelle\":\"Soupe de legumes\",\"proteinesG100g\":\"2.0\",\"glucidesG100g\":\"5.0\",\"lipidesG100g\":\"0.3\",\"fibresG100g\":\"1.5\",\"poidsTotalG\":300,\"kcal100g\":\"30\",\"tempsPreparation\":\"20 min\",\"cycleProduction\":1,\"categorieRecette\":\"/api/categorie_recettes/3\"}", "options": { "raw": { "language": "json" } } }
          }
        },
        { "name": "GET ingredients de la recette 1", "request": { "method": "GET", "url": "{{base_url}}/api/recettes/1/ingredients" } }
      ]
    },
    {
      "name": "5. Recoltes & Stock",
      "item": [
        { "name": "GET Recolte (liste)", "request": { "method": "GET", "url": "{{base_url}}/api/recoltes" } },
        {
          "name": "POST Recolte (admin ou ferme)",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/ld+json" }],
            "url": "{{base_url}}/api/recoltes",
            "body": { "mode": "raw", "raw": "{\"moduleCulture\":\"Module D1\",\"dateSemis\":\"2026-09-23\",\"dateRecoltePrevue\":\"2026-12-01\",\"quantitePrevueG\":2000,\"statut\":\"semis\",\"aliment\":\"/api/aliments/TOMATE\"}", "options": { "raw": { "language": "json" } } }
          }
        },
        { "name": "GET LotStock (liste)", "request": { "method": "GET", "url": "{{base_url}}/api/lot_stocks" } },
        {
          "name": "POST LotStock (admin ou ferme)",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/ld+json" }],
            "url": "{{base_url}}/api/lot_stocks",
            "body": { "mode": "raw", "raw": "{\"qrCode\":\"QR-TEST-0001\",\"quantiteInitialeG\":1000,\"quantiteDisponibleG\":1000,\"dateEntree\":\"2026-09-23\",\"datePeremption\":\"2026-10-23\",\"emplacement\":\"Reserve A - Test\",\"typeReserve\":\"courante\",\"statut\":\"frais\",\"aliment\":\"/api/aliments/TOMATE\"}", "options": { "raw": { "language": "json" } } }
          }
        },
        { "name": "GET MouvementStock (liste)", "request": { "method": "GET", "url": "{{base_url}}/api/mouvement_stocks" } },
        { "name": "GET mouvements de stock lies a la recette 1", "request": { "method": "GET", "url": "{{base_url}}/api/recettes/1/mouvements_stock" } }
      ]
    },
    {
      "name": "6. Planning & Journal",
      "item": [
        { "name": "GET PlanningRepas (liste)", "request": { "method": "GET", "url": "{{base_url}}/api/planning_repas" } },
        {
          "name": "POST PlanningRepas (admin uniquement)",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/ld+json" }],
            "url": "{{base_url}}/api/planning_repas",
            "body": { "mode": "raw", "raw": "{\"date\":\"2026-09-25\",\"portionsPrevues\":4,\"typeRepas\":\"Dejeuner\",\"recette\":\"/api/recettes/1\"}", "options": { "raw": { "language": "json" } } }
          }
        },
        { "name": "GET PlanningRepasOccupant (liste)", "request": { "method": "GET", "url": "{{base_url}}/api/planning_repas_occupants" } },
        { "name": "GET JournalRepas (liste)", "request": { "method": "GET", "url": "{{base_url}}/api/journal_repas" } },
        {
          "name": "POST JournalRepas (admin ou occupant)",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/ld+json" }],
            "url": "{{base_url}}/api/journal_repas",
            "body": { "mode": "raw", "raw": "{\"dateHeure\":\"2026-09-23T12:30:00\",\"portionG\":300,\"recette\":\"/api/recettes/1\",\"equipage\":\"/api/equipages/1\",\"typeRepas\":\"/api/type_repas/2\"}", "options": { "raw": { "language": "json" } } }
          }
        }
      ]
    },
    {
      "name": "7. Utilisateurs (admin uniquement)",
      "item": [
        { "name": "GET User (liste)", "request": { "method": "GET", "url": "{{base_url}}/api/users" } },
        { "name": "GET User 1", "request": { "method": "GET", "url": "{{base_url}}/api/users/1" } }
      ]
    },
    {
      "name": "8. Moteur - Besoins & Ecarts",
      "item": [
        { "name": "GET besoins de l'equipier 1", "request": { "method": "GET", "url": "{{base_url}}/api/equipages/1/besoins" } },
        { "name": "GET besoins de toute l'equipe", "request": { "method": "GET", "url": "{{base_url}}/api/equipages/besoins?date=2026-09-23" } },
        { "name": "GET besoins pour le creneau Dejeuner", "request": { "method": "GET", "url": "{{base_url}}/api/equipages/besoins/creneau?date=2026-09-23&type_repas=Dejeuner" } },
        { "name": "GET ecart nutritionnel de l'equipier 1 (7 jours)", "request": { "method": "GET", "url": "{{base_url}}/api/equipages/1/ecart-nutritionnel?periode_jours=7" } },
        { "name": "GET profil nutritionnel de la recette 1", "request": { "method": "GET", "url": "{{base_url}}/api/recettes/1/profil-nutritionnel" } }
      ]
    },
    {
      "name": "9. Moteur - Stock & Previsions",
      "item": [
        { "name": "GET autonomie du stock", "request": { "method": "GET", "url": "{{base_url}}/api/stock/autonomie" } },
        { "name": "GET previsions 8 semaines", "request": { "method": "GET", "url": "{{base_url}}/api/stock/previsions?semaines=8" } },
        { "name": "GET besoins agricoles (semaine 1)", "request": { "method": "GET", "url": "{{base_url}}/api/stock/besoins-agricoles?semaine=1&semaines=8" } }
      ]
    },
    {
      "name": "10. Moteur - Planning & Journal (calcule)",
      "item": [
        {
          "name": "POST simuler un planning (sans rien ecrire)",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/planning-repas/simuler",
            "body": { "mode": "raw", "raw": "{\"equipage_ids\":[1,2],\"repas\":[{\"date\":\"2026-09-23\",\"type_repas\":\"Diner\",\"recette_id\":3,\"portions\":2}]}", "options": { "raw": { "language": "json" } } }
          }
        },
        {
          "name": "POST generer un planning (admin uniquement, ecrit en base)",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/planning-repas/generer",
            "body": { "mode": "raw", "raw": "{\"equipage_ids\":[2,3,4],\"date_debut\":\"2026-09-26\",\"horizon_jours\":2,\"autoriser_rupture_stock\":true}", "options": { "raw": { "language": "json" } } }
          }
        },
        { "name": "GET lire le planning", "request": { "method": "GET", "url": "{{base_url}}/api/planning-repas?date_debut=2026-09-23" } },
        {
          "name": "POST enregistrer un repas consomme (admin ou occupant)",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/journal-repas",
            "body": { "mode": "raw", "raw": "{\"equipage_id\":1,\"recette_id\":3,\"type_repas_id\":2,\"date_heure\":\"2026-09-23T12:00:00\",\"sortie_stock\":false}", "options": { "raw": { "language": "json" } } }
          }
        }
      ]
    }
  ]
}
