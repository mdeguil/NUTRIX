# Deploiement Vercel (runtime "container") via FrankenPHP.
# Doc officielle : https://vercel.com/kb/guide/symfony-php-with-docker

FROM dunglas/frankenphp:1-php8.4-bookworm AS base

RUN install-php-extensions \
    intl \
    zip \
    pdo_pgsql \
    mbstring \
    ctype \
    opcache

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /app


FROM base AS dependencies

ENV APP_ENV=prod
ENV APP_DEBUG=0

COPY composer.json composer.lock symfony.lock ./
RUN composer install --no-dev --no-scripts --no-interaction --optimize-autoloader --no-progress

COPY . .

# Placeholders uniquement pour compiler le container Symfony pendant le build (jamais copies
# dans l'image finale : le stage "runtime" ne recupere que les fichiers, pas ces variables).
# Les vraies valeurs viennent des variables d'environnement Vercel au demarrage.
ENV APP_SECRET=build-placeholder
ENV JWT_SECRET_KEY=build-placeholder
ENV JWT_PUBLIC_KEY=build-placeholder
ENV JWT_PASSPHRASE=build-placeholder
ENV DATABASE_URL="postgresql://user:pass@127.0.0.1:5432/db?serverVersion=16&charset=utf8"
ENV CORS_ALLOW_ORIGIN='^$'
ENV DEFAULT_URI=http://localhost

# dump-env avec --empty genere .env.local.php sans figer de valeur en dur dans l'image.
# assets:install/importmap:install sont normalement lances par les scripts post-install de Composer
# (auto-scripts), desactives ici via --no-scripts : il faut donc les rejouer explicitement, sinon
# public/bundles/ (assets Swagger UI d'API Platform, /api/docs) et assets/vendor/ restent absents.
# asset-map:compile est indispensable en prod : AssetMapper ne sert les fichiers /assets/... via PHP
# qu'en dev, en prod il faut les precompiler en fichiers statiques (public/assets/) servis par Caddy,
# sinon toutes les URLs versionnees (asset() Twig) renvoient 404.
RUN composer dump-autoload --classmap-authoritative --no-dev \
    && composer dump-env prod --empty \
    && php bin/console cache:clear --env=prod --no-debug \
    && php bin/console assets:install public --env=prod --no-debug \
    && php bin/console importmap:install --env=prod --no-debug \
    && php bin/console asset-map:compile --env=prod --no-debug


FROM base AS runtime

ENV APP_ENV=prod
ENV APP_DEBUG=0
ENV SERVER_NAME=:80

# "dump-env --empty" ne reprend aucune valeur de .env : sans ces valeurs par defaut, les variables
# non secretes que .env definissait n'existent pas en prod, et /api/login plante en 500
# ("Environment variable not found: JWT_SECRET_KEY") des qu'il construit le gestionnaire JWT.
# Les variables d'environnement Vercel restent prioritaires. Les secrets (APP_SECRET, JWT_PASSPHRASE,
# DATABASE_URL, JWT_*_KEY_B64) n'ont volontairement pas de valeur par defaut.
ENV JWT_SECRET_KEY=/app/config/jwt/private.pem
ENV JWT_PUBLIC_KEY=/app/config/jwt/public.pem
ENV MESSENGER_TRANSPORT_DSN="doctrine://default?auto_setup=0"
ENV MAILER_DSN=null://null
ENV DEFAULT_URI=http://localhost
ENV CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'

COPY --from=dependencies /app /app
COPY Caddyfile /etc/caddy/Caddyfile

RUN chown -R www-data:www-data /app/var

EXPOSE 80

# Les cles JWT ne sont jamais commitees (.gitignore) : elles sont fournies en base64 par les
# variables d'environnement Vercel (JWT_PRIVATE_KEY_B64 / JWT_PUBLIC_KEY_B64) et decodees ici,
# au demarrage du conteneur, avant de lancer FrankenPHP.
#
# Les migrations Doctrine sont ensuite appliquees (elles sont rejouables : colonnes en IF NOT EXISTS).
# Un echec (base injoignable…) est journalise sans empecher l'API de demarrer, et le delai est borne
# pour ne pas bloquer le demarrage a froid.
CMD ["sh", "-c", "mkdir -p /app/config/jwt && if [ -n \"$JWT_PRIVATE_KEY_B64\" ]; then echo \"$JWT_PRIVATE_KEY_B64\" | base64 -d > /app/config/jwt/private.pem; fi && if [ -n \"$JWT_PUBLIC_KEY_B64\" ]; then echo \"$JWT_PUBLIC_KEY_B64\" | base64 -d > /app/config/jwt/public.pem; fi && (timeout 45 php bin/console doctrine:migrations:migrate --no-interaction --allow-no-migration --all-or-nothing || echo '[nutrix] migrations non appliquees au demarrage') && exec frankenphp run --config /etc/caddy/Caddyfile"]
